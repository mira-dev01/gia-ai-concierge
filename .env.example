# Copy to .env (never commit .env) and fill in on your machine.

# --- Groq ---
GROQ_API_KEY=
GIA_MODEL=llama-3.3-70b-versatile

# --- Meta / WhatsApp Business Cloud API (developers.facebook.com > your app > WhatsApp > API Setup) ---
# Temporary token (24h) for a first test; a System User permanent token for the demo day
WHATSAPP_TOKEN=
# "Phone number ID" (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose; paste the same value into Meta's webhook "Verify token" field
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (used to check webhook signatures)
META_APP_SECRET=
GRAPH_API_VERSION=v23.0
# hello_world works on test numbers; switch to your approved template (one {{1}} = guest first name)
WELCOME_TEMPLATE=hello_world
WELCOME_TEMPLATE_LANG=en_US

# --- Demo ---
# Password for the /admin ops console (username can be anything)
ADMIN_PASSWORD=
# Attach any unknown WhatsApp number to this sample booking, so your own phone chats as that guest
DEMO_BOOKING_ID=LH-24009
# true = log outbound WhatsApp messages instead of sending them
DRY_RUN=false
